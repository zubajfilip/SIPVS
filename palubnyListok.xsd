<?xml version="1.0"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="1.0" targetNamespace="http://www.stuba.sk/sipvs/palubny-listok"
xmlns="http://www.stuba.sk/sipvs/palubny-listok" elementFormDefault="qualified">
    <xsd:element name="palubneListky" type="palubneListkyType"/>

    <xsd:simpleType name="pnrType">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value ="[A-Z0-9]{6}"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="cisloLetuType">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value ="[A-Z0-9]{2}\d{1,4}"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="kodLetiskaType">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value ="[A-Z]{3}"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="gateType">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value ="[A-Z]\d{1,2}"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="sedadloType">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value ="\d{1,2}[A-K]"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="triedaType">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="economy"/>
            <xsd:enumeration value="business"/>
            <xsd:enumeration value="first"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="titulType">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="MR"/>
            <xsd:enumeration value="MRS"/>
            <xsd:enumeration value="MS"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="batozinaKgType">
        <xsd:restriction base="xsd:decimal">
            <xsd:minInclusive value="0"/>
            <xsd:maxInclusive value="32"/>
            <xsd:fractionDigits value="1"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="miestoType">
        <xsd:sequence>
            <xsd:element name="letisko" type="kodLetiskaType"/>
            <xsd:element name="mesto" type="xsd:string"/>
            <xsd:element name="cas" type="xsd:dateTime"/>
            <xsd:element name="terminal" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="letType">
        <xsd:sequence>
            <xsd:element name="cisloLetu" type="cisloLetuType"/>
            <xsd:element name="dopravca" type="xsd:string"/>
            <xsd:element name="odlet" type="miestoType"/>
            <xsd:element name="prilet" type="miestoType"/>
            <xsd:element name="dlzkaLetu" type="xsd:duration"/>
            <xsd:element name="gate" type="gateType"/>
            <xsd:element name="nastup" type="xsd:time"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="pasazierType">
        <xsd:sequence>
            <xsd:element name="titul" type="titulType"/>
            <xsd:element name="meno" type="xsd:string"/>
            <xsd:element name="priezvisko" type="xsd:string"/>
            <xsd:element name="datumNarodenia" type="xsd:date"/>
            <xsd:element name="sedadlo" type="sedadloType"/>
            <xsd:element name="batozinaKg" type="batozinaKgType"/>
            <xsd:element name="prednostnyNastup" type="xsd:boolean"/>
        </xsd:sequence>
        <xsd:attribute name="trieda" type="triedaType" use="required"/>
    </xsd:complexType>

    <xsd:complexType name="pasazieriType">
        <xsd:sequence>
            <xsd:element name="pasazier" type="pasazierType" minOccurs="1" maxOccurs="9"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="palubneListkyType">
        <xsd:sequence>
            <xsd:element name="let" type="letType"/>
            <xsd:element name="pasazieri" type="pasazieriType"/>
        </xsd:sequence>
        <xsd:attribute name="rezervacia" type="pnrType" use="required"/>
    </xsd:complexType>

</xsd:schema>